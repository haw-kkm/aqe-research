# Copy to .env (never commit). AQE reads secrets from environment variables only.
# PostgreSQL/TimescaleDB DSN (optional; without it the local SQLite store is used and DB checks are BLOCKED)
AQE_PG_DSN=
# LLM provider keys (only needed when context.backend is simple_llm/tradingagents AND a cost cap > 0 is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Fixture test root used by configs/fixture.yaml
AQE_FIXTURE_ROOT=
# Enable network tests (pytest -m network)
AQE_NETWORK_TESTS=0
