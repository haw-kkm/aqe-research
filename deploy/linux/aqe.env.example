# /etc/aqe/aqe.env — read by the systemd units (EnvironmentFile). NO secrets here: API keys (if ever used) go in
# /etc/aqe/secrets.env (mode 0600, root:aqe) and are never committed. Copy this file, then edit per host.
AQE_HOME=/opt/aqe
AQE_DATA_ROOT=/srv/aqe/data
AQE_ARTIFACT_ROOT=/srv/aqe/artifacts
# role config (relative to the release checkout /opt/aqe/current)
AQE_COLLECTOR_CONFIG=configs/cloud/oracle_collector.yaml
AQE_SHADOW_CONFIG=configs/cloud/oracle_shadow.yaml
AQE_MIN_FREE_GB=20
PYTHONPATH=/opt/aqe/current/src
PYTHONUNBUFFERED=1
# LLM spending stays at the config's caps (max_cost_usd_per_day: 0.0 => paid calls refused)
