# /etc/aqe/aqe.env — read by the systemd units (EnvironmentFile). NO secrets here: API keys (if ever used) go in
# /etc/aqe/secrets.env (mode 0600, root:aqe) and are never committed. bootstrap_host.sh creates the file once from this
# example with the role's values (AQE_ROLE, AQE_COLLECTOR_CONFIG, AQE_MIN_FREE_GB) and never overwrites it.
# This host's role: oracle-collector | oracle-shadow | google-collector | google-cpu-train | google-gpu-train.
# The collector unit runs `preflight --role ${AQE_ROLE}`; install_release.sh refuses a different role.
AQE_ROLE=oracle-collector
AQE_HOME=/opt/aqe
AQE_DATA_ROOT=/srv/aqe/data
AQE_ARTIFACT_ROOT=/srv/aqe/artifacts
# role config (relative to the release checkout /opt/aqe/current):
#   oracle-collector -> configs/cloud/oracle_collector.yaml, google-collector -> configs/cloud/google_collector.yaml
AQE_COLLECTOR_CONFIG=configs/cloud/oracle_collector.yaml
AQE_SHADOW_CONFIG=configs/cloud/oracle_shadow.yaml
# the collector stops (and preflight fails) below this free space on data_root; health warns at the same level.
# Oracle (200 GB Always Free block volume): 20. Google (separate persistent disk, sized by you): 10.
AQE_MIN_FREE_GB=20
PYTHONPATH=/opt/aqe/current/src
PYTHONUNBUFFERED=1
# LLM spending stays at the config's caps (max_cost_usd_per_day: 0.0 => paid calls refused)
